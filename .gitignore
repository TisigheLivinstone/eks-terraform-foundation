# Terraform state — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan

# Terraform directory
.terraform/
.terraform.lock.hcl

# Variable files with real values — use terraform.tfvars.example instead
# (only ignore if you put secrets in tfvars)
# terraform.tfvars

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Mac
.DS_Store

# Editor
.idea/
.vscode/
*.swp
